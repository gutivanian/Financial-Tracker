# Database Configuration
DB_USER=your_db_user
DB_HOST=your_db_host
DB_NAME=personal-finance
DB_PASSWORD=your_db_password
DB_PORT=5432
DB_SSL=true
DB_CA_PATH=./ca.pem

# Next.js API URL
# Development: http://localhost:3002
# Production: Your production URL
NEXT_PUBLIC_API_URL=http://localhost:3002

# SSO Configuration
# Development: SSO at port 3001, PFTU at port 3002
# Production: Update to your production SSO URL
NEXT_PUBLIC_SSO_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002

# JWT Secret
# IMPORTANT: Must be the SAME as SSO JWT_SECRET!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-shared-jwt-secret-with-sso-minimum-32-characters

# Optional API Keys (get free keys from these services)
ALPHA_VANTAGE_API_KEY=your_key_here
FINNHUB_API_KEY=your_key_here